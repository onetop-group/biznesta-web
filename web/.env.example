# BIZNESTA — 상담 문의 저장에 필요한 환경변수
#
# 실제 값은 이 파일에 적지 않는다. 로컬은 .env.local, 배포는 Vercel 프로젝트
# 환경변수에 넣는다. (.env.local 은 커밋하지 않는다)
#
#   로컬:    web/.env.local 에 아래 두 줄을 값과 함께 추가
#   Vercel:  npx vercel env add SUPABASE_URL
#            npx vercel env add SUPABASE_ANON_KEY
#
# 두 값은 Supabase 대시보드 > Project Settings > API 에 있다.
# anon key 는 브라우저에 노출되어도 되는 공개 키이며, 실제 보호 경계는
# supabase/migrations/0001_inquiries.sql 의 RLS 정책이다.
#
# service_role 키는 이 기능에 필요하지 않다. 클라이언트 번들에 절대 넣지 않는다.

# 서버에서만 읽는다. NEXT_PUBLIC_ 접두사를 붙이지 않는 쪽을 권장한다.
SUPABASE_URL=
SUPABASE_ANON_KEY=

# 이미 NEXT_PUBLIC_ 이름으로 넣어 둔 프로젝트라면 그 이름도 그대로 인식한다.
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ── STORE / 결제 (STEP D-1 에서 이름만 정했다. 아직 값을 넣지 않는다) ──────
#
# STORE_DATABASE_URL 은 PAYMENT CORE 가 쓰는 PostgreSQL 연결 문자열이다.
# 왜 필요한가: CORE 의 withActor 는 begin → pay_set_actor → 쓰기 → commit 을
#   한 트랜잭션으로 묶어야 한다. supabase-js(PostgREST)로는 그게 안 된다.
# 언제 필요한가: 실제 결제(STEP E)를 시작할 때. 지금은 없어도 홈페이지와
#   /store 화면이 정상 동작한다 (관리자 > 시스템 상태에 '미설정' 으로 나온다).
# 어떤 값인가: Supabase > Project Settings > Database > Connection string 의
#   ★ Transaction pooler (6543) 를 쓴다. serverless 에서는 세션을 오래 붙잡는
#   Session pooler(5432)를 쓰면 연결이 금방 고갈된다.
# ★ 서버 전용이다. NEXT_PUBLIC_ 을 붙이지 않는다. 브라우저로 내보내지 않는다.
# STORE_DATABASE_URL=
