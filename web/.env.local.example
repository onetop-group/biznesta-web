# ─────────────────────────────────────────────────────────────
#  BIZNESTA — 환경변수 예시
#  실제 값은 .env.local 에 넣습니다 (.env.local 은 커밋되지 않습니다)
# ─────────────────────────────────────────────────────────────

# 사이트 기본 URL — canonical · sitemap · OG 절대경로의 유일한 출처
#   · 도메인 확정 전에는 비워 두세요.
#   · 비어 있으면 Vercel 이 주입하는 배포 URL 을 자동으로 사용합니다.
#   · 도메인이 확정되면 이 값 하나만 바꾸면 전 페이지에 반영됩니다.
NEXT_PUBLIC_SITE_URL=

# ── 아래는 Phase 6(Supabase 연동)에서 사용합니다 ──────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# ⚠️ SERVICE_ROLE_KEY 는 서버 전용입니다. NEXT_PUBLIC_ 접두사를 절대 붙이지 마세요.
SUPABASE_SERVICE_ROLE_KEY=
